# ========== 必填（生产环境请务必修改） ==========
# 管理员账号，登录后台使用
ADMIN_USERNAME=admin
# 管理员初始密码；首次启动会创建或同步此密码
ADMIN_PASSWORD=change-me-please
# Cookie 签名密钥，请使用 openssl rand -hex 32 生成
SECRET_KEY=please-generate-a-random-secret-key
# 后台域名，例如 https://test.example.com。留空则不校验 Origin（仅靠 SameSite + CSRF 双提交）。
ALLOWED_ORIGIN=
# 仅当应用只通过可信反向代理访问时开启；用于按真实客户端 IP 限流
TRUST_PROXY_HEADERS=false

# ========== 数据库与运行环境 ==========
# SQLite 文件路径（容器内路径，一般不需要修改）
DATABASE_URL=sqlite:////app/data/code_judge.db
# Runner 内部服务地址（Docker 内部网络自动解析服务名）
RUNNER_URL=http://runner:8100
# 前端构建产物目录（容器内路径）
FRONTEND_DIST=/app/static

# ========== 安全选项 ==========
# 使用 HTTPS 时改为 true；使用 HTTP 直连时必须为 false
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_MAX_AGE_SECONDS=43200

# ========== 判题并发与限流 ==========
JUDGE_MAX_CONCURRENCY=4
JUDGE_QUEUE_SIZE=50
JUDGE_RATE_PER_MINUTE=10
ADMIN_VERIFY_MAX_CONCURRENCY=2
ADMIN_VERIFY_RATE_PER_MINUTE=20

# ========== 判题限制 ==========
MAX_SOURCE_BYTES=65536
MAX_CUSTOM_INPUT_BYTES=1048576
MAX_TEST_CASES=20
MAX_CASE_BYTES=1048576
